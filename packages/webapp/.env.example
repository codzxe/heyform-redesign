VITE_HOMEPAGE_URL=http://127.0.0.1:3000
VITE_COOKIE_DOMAIN=127.0.0.1
VITE_PROXY_TARGET=http://127.0.0.1:9157
VITE_GRAPHQL_API_URL=/graphql
VITE_CDN_UPLOAD_URL=/api

VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_RECAPTCHA_KEY=

VITE_DISABLE_LOGIN_WITH_GOOGLE=false
VITE_DISABLE_LOGIN_WITH_APPLE=false
# Frontend-only fallback for direct Vite development. The server injects this in production.
VITE_DISABLE_LOGIN_WITH_OIDC=true
VITE_OIDC_DISPLAY_NAME=SSO
VITE_OIDC_DISPLAY_ICON_URL=

VITE_VERIFY_USER_EMAIL=true
VITE_ENABLE_GOOGLE_FONTS=true

# Vite dev-server Host-header allowlist. Reverse-proxied previews (e.g. cloud
# sandbox gateways) reach the dev server under an external hostname, which
# Vite blocks by default. "true" allows any host (development only), or a
# comma-separated list of allowed hostnames. Leave empty for Vite's defaults.
VITE_ALLOWED_HOSTS=
